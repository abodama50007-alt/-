        "totalCorrect",
        "bestScorePct",
        "bestStreak",
        "testedSurahs",
        "testedJuzs",
        "lastTestedLabel",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {

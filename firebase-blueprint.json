    "CompanionRoom": {
      "title": "CompanionRoom",
      "description": "Real-time 2-player Quran memorization companion and live quiz competition room",
      "type": "object",
      "properties": {
        "roomCode": {
          "type": "string",
          "description": "6-12 char uppercase room code matching doc ID",
          "minLength": 6,
          "maxLength": 12,
          "pattern": "^[A-Z0-9]{6,12}$"
        },
        "title": {
          "type": "string",
          "description": "Room title",
          "minLength": 1,
          "maxLength": 100
        },
        "hostUid": {
          "type": "string",
          "description": "Creator Firebase UID",
          "minLength": 1,
          "maxLength": 128
        },
        "hostName": {
          "type": "string",
          "description": "Creator display name",
          "minLength": 1,
          "maxLength": 80
        },
        "guestUid": {
          "type": "string",
          "description": "Joined friend Firebase UID or empty string while waiting",
          "maxLength": 128
        },
        "guestName": {
          "type": "string",
          "description": "Joined friend display name or empty string while waiting",
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "active", "finished"],
          "description": "Current room lifecycle state"
        },
        "mode": {
          "type": "string",
          "enum": ["hifz", "sunnah", "mixed"],
          "description": "Quiz category mode"
        },
        "questionIds": {
          "type": "array",
          "description": "Ordered list of competition question IDs (1..12)"
        },
        "hostScore": {
          "type": "integer",
          "description": "Host cumulative score"
        },
        "guestScore": {
          "type": "integer",
          "description": "Guest cumulative score"
        },
        "hostAnsweredCount": {
          "type": "integer",
          "description": "Number of questions answered by host"
        },
        "guestAnsweredCount": {
          "type": "integer",
          "description": "Number of questions answered by guest"
        },
        "sharedSurahNumber": {
          "type": "integer",
          "description": "Shared Surah number 1..114 for co-memorization"
        },
        "sharedAyahNumber": {
          "type": "integer",
          "description": "Shared Ayah number 1..286 for co-memorization"
        },
        "currentQuestionIndex": {
          "type": "integer",
          "description": "Synchronized active question index 0..12"
        },
        "hostAnswerForCurrent": {
          "type": "integer",
          "description": "Host answer for currentQuestionIndex (-1 pending, -2 timeout, 0..3 option)"
        },
        "guestAnswerForCurrent": {
          "type": "integer",
          "description": "Guest answer for currentQuestionIndex (-1 pending, -2 timeout, 0..3 option)"
        },
        "hostReady": {
          "type": "boolean",
          "description": "Host live readiness state"
        },
        "guestReady": {
          "type": "boolean",
          "description": "Guest live readiness state"
        },
        "questionStartedAtMs": {
          "type": "integer",
          "description": "Synchronized start timestamp (epoch ms) for current question timer"
        },
        "liveEventText": {
          "type": "string",
          "description": "Latest live match event summary",
          "minLength": 0,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "roomCode",
        "title",
        "hostUid",
        "hostName",
        "guestUid",
        "guestName",
        "status",
        "mode",
        "questionIds",
        "hostScore",
        "guestScore",
        "hostAnsweredCount",
        "guestAnsweredCount",
        "sharedSurahNumber",
        "sharedAyahNumber",
        "currentQuestionIndex",
        "hostAnswerForCurrent",
        "guestAnswerForCurrent",
        "hostReady",
        "guestReady",
        "questionStartedAtMs",
        "liveEventText",
        "createdAt",
        "updatedAt"
      ]
    },
    "CompanionMessage": {
      "title": "CompanionMessage",
      "description": "Immutable chat, encouragement nudge, or shared Ayah notification inside a companion room",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message ID matching doc ID",
          "minLength": 1,
          "maxLength": 64
        },
        "uid": {
          "type": "string",
          "description": "Sender UID",
          "minLength": 1,
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "description": "Sender display name",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "type": "string",
          "enum": ["chat", "nudge", "ayah_share"],
          "description": "Message classification"
        },
        "text": {
          "type": "string",
          "description": "Arabic message content",
          "minLength": 1,
          "maxLength": 400
        },
        "surahNumber": {
          "type": "integer",
          "description": "Optional shared Surah number 1..114"
        },
        "ayahNumber": {
          "type": "integer",
          "description": "Optional shared Ayah number 1..286"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": [
        "id",
        "uid",
        "senderName",
        "kind",
        "text",
        "surahNumber",
        "ayahNumber",
        "createdAt"
      ]
    },

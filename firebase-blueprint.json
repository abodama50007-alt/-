          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "totalTasbeehCount": {
          "type": "integer",
          "description": "Total cumulative tasbeeh count"
        },
        "khatmahCurrentPage": {
          "type": "integer",
          "description": "Current Mushaf page 1..604"
        },
        "khatmahTargetDays": {
          "type": "integer",
          "description": "Target days for current khatmah"
        },
        "khatmahCompletedJuz": {
          "type": "array",
          "description": "List of completed Juz numbers 1..30"
        },
        "lastReadSurah": {
          "type": "integer",
          "description": "Last read Surah number"
        },
        "lastReadSurahName": {
          "type": "string",
          "description": "Last read Surah Arabic name",
          "maxLength": 120
        },
        "lastReadAyah": {
          "type": "integer",
          "description": "Last read ayah number in surah"
        },
        "lastReadPage": {
          "type": "integer",
          "description": "Last read Mushaf page"
        },
        "lastReadJuz": {
          "type": "integer",
          "description": "Last read Juz"
        },
        "reciterId": {
          "type": "string",
          "description": "Preferred Quran reciter identifier",
          "maxLength": 120

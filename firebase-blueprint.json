      "required": [
        "uid",
        "totalTasbeehCount",
        "khatmahCurrentPage",
        "khatmahTargetDays",
        "khatmahCompletedJuz",
        "lastReadSurah",
        "lastReadSurahName",
        "lastReadAyah",
        "lastReadPage",
        "lastReadJuz",
        "reciterId",
        "tafsirEdition",
        "readingMode",
        "fontSize",
        "themeMode",
        "adhanId",
        "updatedAt"
      ]
